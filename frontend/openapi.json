{
  "openapi": "3.1.0",
  "info": {
    "title": "Retro API",
    "description": "Team retrospectives.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "v1"
  },
  "paths": {
    "/api/v1/auth/config": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Returns the sign-in options.",
        "operationId": "config",
        "responses": {
          "200": {
            "description": "Sign-in options",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthConfig"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signs in with a username or email and a password.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in; sets the refresh cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Local sign-in disabled",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signs out: revokes the session and clears the cookie.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Signed out; clears the refresh cookie"
          }
        }
      }
    },
    "/api/v1/auth/oidc": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Starts single sign-on: redirects to the identity provider.",
        "operationId": "oidc_start",
        "parameters": [
          {
            "name": "redirect",
            "in": "query",
            "description": "Local path to open after signing in.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "remember",
            "in": "query",
            "description": "\"Keep me signed in\".",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect to the identity provider"
          }
        }
      }
    },
    "/api/v1/auth/oidc/callback": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Completes single sign-on: verifies the provider's answer, signs the user\nin, sets the refresh cookie and returns to the app. No token is put in the URL.",
        "operationId": "oidc_callback",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "error",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect to /auth/callback, or to /login?error=… on failure"
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Exchanges the refresh cookie for a new access token (and rotates the cookie).",
        "operationId": "refresh_session",
        "responses": {
          "200": {
            "description": "Session renewed; rotates the refresh cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or revoked refresh cookie",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/invitations/{token}": {
      "get": {
        "tags": [
          "invitations"
        ],
        "summary": "Shows an invitation to whoever holds its link.",
        "operationId": "get_invitation",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "description": "Invitation token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The invitation, in any state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationPreviewDto"
                }
              }
            }
          },
          "404": {
            "description": "`invitation_not_found`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many unknown tokens",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/invitations/{token}/accept": {
      "post": {
        "tags": [
          "invitations"
        ],
        "summary": "Accepts an invitation: the caller joins the team as a member.",
        "operationId": "accept_invitation",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "description": "Invitation token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The team joined",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamRefDto"
                }
              }
            }
          },
          "404": {
            "description": "`invitation_not_found`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "410": {
            "description": "`invitation_expired`, `invitation_revoked` or `invitation_used`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many unknown tokens",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/invitations/{token}/decline": {
      "post": {
        "tags": [
          "invitations"
        ],
        "summary": "Declines an invitation.",
        "operationId": "decline_invitation",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "description": "Invitation token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Declined"
          },
          "404": {
            "description": "`invitation_not_found`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "410": {
            "description": "`invitation_expired`, `invitation_revoked` or `invitation_used`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many unknown tokens",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/join/{token}": {
      "post": {
        "tags": [
          "teams"
        ],
        "summary": "Joins the team behind an enabled join link as a member.",
        "operationId": "join_team",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "description": "Join link token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Joined (or already a member)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinResponse"
                }
              }
            }
          },
          "404": {
            "description": "`join_link_invalid`: unknown, replaced or disabled",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many unknown tokens",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Returns the signed-in user with their teams and pending invitations.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "The signed-in user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/teams": {
      "get": {
        "tags": [
          "teams"
        ],
        "summary": "Lists the caller's teams.",
        "operationId": "list_teams",
        "responses": {
          "200": {
            "description": "The caller's teams, by name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TeamDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "teams"
        ],
        "summary": "Creates a team. The caller becomes its first admin.",
        "operationId": "create_team",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TeamNameRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The new team",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamDto"
                }
              }
            }
          },
          "400": {
            "description": "`invalid_team_name`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/teams/{team_id}": {
      "get": {
        "tags": [
          "teams"
        ],
        "summary": "Returns one of the caller's teams.",
        "operationId": "get_team",
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "description": "Team id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The team",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamDto"
                }
              }
            }
          },
          "404": {
            "description": "`team_not_found`: no such team or not a member",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "delete": {
        "tags": [
          "teams"
        ],
        "summary": "Deletes a team and everything in it (admin).",
        "operationId": "delete_team",
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "description": "Team id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "403": {
            "description": "Not an admin",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "`team_not_found`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "patch": {
        "tags": [
          "teams"
        ],
        "summary": "Renames a team (admin).",
        "operationId": "rename_team",
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "description": "Team id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TeamNameRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The renamed team",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamDto"
                }
              }
            }
          },
          "400": {
            "description": "`invalid_team_name`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Not an admin",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "`team_not_found`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/teams/{team_id}/invitations": {
      "get": {
        "tags": [
          "invitations"
        ],
        "summary": "Lists a team's open invitations (any member).",
        "operationId": "list_invitations",
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "description": "Team id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Open invitations, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InvitationDto"
                  }
                }
              }
            }
          },
          "404": {
            "description": "`team_not_found`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "invitations"
        ],
        "summary": "Invites someone by email (any member). Returns the open invitation for\nthat email if there already is one.",
        "operationId": "create_invitation",
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "description": "Team id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The invitation and its personal link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationDto"
                }
              }
            }
          },
          "400": {
            "description": "`invalid_email`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "`team_not_found`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "`already_member`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many invitations",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/teams/{team_id}/invitations/{invitation_id}": {
      "delete": {
        "tags": [
          "invitations"
        ],
        "summary": "Revokes an invitation (its inviter or an admin).",
        "operationId": "revoke_invitation",
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "description": "Team id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "invitation_id",
            "in": "path",
            "description": "Invitation id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "403": {
            "description": "Neither the inviter nor an admin",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "`team_not_found` or `invitation_not_found`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/teams/{team_id}/join-link": {
      "get": {
        "tags": [
          "teams"
        ],
        "summary": "Returns the team join link (any member).",
        "operationId": "get_join_link",
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "description": "Team id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The join link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinLinkDto"
                }
              }
            }
          },
          "404": {
            "description": "`team_not_found`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "teams"
        ],
        "summary": "Regenerates, enables or disables the join link (admin).",
        "operationId": "update_join_link",
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "description": "Team id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinLinkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The updated join link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinLinkDto"
                }
              }
            }
          },
          "403": {
            "description": "Not an admin",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "`team_not_found`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/teams/{team_id}/members": {
      "get": {
        "tags": [
          "teams"
        ],
        "summary": "Lists the members of a team, admins first.",
        "operationId": "list_members",
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "description": "Team id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Members",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MemberDto"
                  }
                }
              }
            }
          },
          "404": {
            "description": "`team_not_found`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/teams/{team_id}/members/{user_id}": {
      "delete": {
        "tags": [
          "teams"
        ],
        "summary": "Removes a member (admin) or leaves the team (own user id). When the last\nmember leaves, the team is deleted.",
        "operationId": "remove_member",
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "description": "Team id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "user_id",
            "in": "path",
            "description": "Member's user id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removed"
          },
          "403": {
            "description": "Not an admin",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "`team_not_found` or `member_not_found`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "`last_admin`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "patch": {
        "tags": [
          "teams"
        ],
        "summary": "Promotes or demotes a member (admin). The last admin cannot be demoted.",
        "operationId": "update_member",
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "description": "Team id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "user_id",
            "in": "path",
            "description": "Member's user id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Role changed"
          },
          "403": {
            "description": "Not an admin",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "`team_not_found` or `member_not_found`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "`last_admin`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "operational"
        ],
        "summary": "Liveness: the process is up.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Alive"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "operational"
        ],
        "summary": "Readiness: the database is reachable and every migration this binary knows\nis applied. Migrations applied by a newer release are ignored, so pods of\nthe previous release stay ready during a rolling upgrade.",
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Not ready"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthConfig": {
        "type": "object",
        "description": "Which sign-in methods the sign-in page offers.",
        "required": [
          "localLogin",
          "sso"
        ],
        "properties": {
          "localLogin": {
            "type": "boolean"
          },
          "passwordResetUrl": {
            "type": [
              "string",
              "null"
            ],
            "description": "Shown as \"Forgot password?\" when set. Retro sends no email itself."
          },
          "sso": {
            "$ref": "#/components/schemas/SsoConfig"
          }
        }
      },
      "InvitationDto": {
        "type": "object",
        "description": "An open invitation, as listed in team settings.",
        "required": [
          "id",
          "email",
          "url",
          "expiresAt"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "invitedBy": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PersonDto"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "type": "string",
            "description": "Personal accept link (`/invite/{token}`) to share with the invitee."
          }
        }
      },
      "InvitationPreviewDto": {
        "type": "object",
        "description": "What `/invite/{token}` shows before the invitee answers.",
        "required": [
          "status",
          "email",
          "expiresAt",
          "team",
          "members",
          "memberCount",
          "alreadyMember"
        ],
        "properties": {
          "alreadyMember": {
            "type": "boolean",
            "description": "The caller already belongs to the team."
          },
          "email": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "invitedBy": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PersonDto"
              },
              {
                "type": "null"
              }
            ]
          },
          "memberCount": {
            "type": "integer",
            "format": "int64"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PersonDto"
            },
            "description": "Up to six members; empty unless the invitation is open."
          },
          "status": {
            "$ref": "#/components/schemas/InvitationStatus",
            "description": "`expired` once past `expiresAt`, whatever is stored."
          },
          "team": {
            "$ref": "#/components/schemas/TeamRefDto"
          }
        }
      },
      "InvitationStatus": {
        "type": "string",
        "description": "Lifecycle of an invitation (spec §6.1).",
        "enum": [
          "pending",
          "accepted",
          "declined",
          "revoked",
          "expired"
        ]
      },
      "InviteRequest": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "JoinLinkActionDto": {
        "type": "string",
        "enum": [
          "regenerate",
          "enable",
          "disable"
        ]
      },
      "JoinLinkDto": {
        "type": "object",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Whether opening the link lets people join."
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Absolute URL of the link; absent if none was ever generated."
          }
        }
      },
      "JoinLinkRequest": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "$ref": "#/components/schemas/JoinLinkActionDto"
          }
        }
      },
      "JoinResponse": {
        "type": "object",
        "required": [
          "team",
          "alreadyMember"
        ],
        "properties": {
          "alreadyMember": {
            "type": "boolean",
            "description": "The caller was a member before opening the link."
          },
          "team": {
            "$ref": "#/components/schemas/TeamRefDto"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "login",
          "password"
        ],
        "properties": {
          "login": {
            "type": "string",
            "description": "Username or email address."
          },
          "password": {
            "type": "string"
          },
          "remember": {
            "type": "boolean",
            "description": "\"Keep me signed in\"."
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "required": [
          "user",
          "teams",
          "invitations"
        ],
        "properties": {
          "invitations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PendingInvitationDto"
            },
            "description": "Open invitations sent to the user's email, newest first."
          },
          "teams": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TeamDto"
            },
            "description": "Teams the user belongs to, by name."
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        }
      },
      "MemberDto": {
        "type": "object",
        "required": [
          "user",
          "role",
          "joinedAt"
        ],
        "properties": {
          "joinedAt": {
            "type": "string",
            "format": "date-time"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        }
      },
      "PendingInvitationDto": {
        "type": "object",
        "description": "An open invitation addressed to the signed-in user (user menu, onboarding).",
        "required": [
          "token",
          "team",
          "expiresAt"
        ],
        "properties": {
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "invitedBy": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PersonDto"
              },
              {
                "type": "null"
              }
            ]
          },
          "team": {
            "$ref": "#/components/schemas/TeamRefDto"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "PersonDto": {
        "type": "object",
        "description": "A user reduced to what other team members may see next to their avatar.",
        "required": [
          "id",
          "displayName"
        ],
        "properties": {
          "displayName": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem details body.",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code, e.g. `invalid_credentials`."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "URI reference identifying the problem type."
          }
        }
      },
      "Role": {
        "type": "string",
        "description": "A member's role in a team (spec §5.1).",
        "enum": [
          "admin",
          "member"
        ]
      },
      "RoleRequest": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "description": "A new session: a short-lived access token (the refresh token is in a cookie).",
        "required": [
          "accessToken",
          "expiresIn",
          "user"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64",
            "description": "Access token lifetime in seconds."
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        }
      },
      "SsoConfig": {
        "type": "object",
        "required": [
          "enabled",
          "buttonText"
        ],
        "properties": {
          "buttonText": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "TeamDto": {
        "type": "object",
        "description": "A team as seen by the caller.",
        "required": [
          "id",
          "name",
          "role",
          "memberCount"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "memberCount": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "description": "The caller's role."
          }
        }
      },
      "TeamNameRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "1–60 characters after trimming."
          }
        }
      },
      "TeamRefDto": {
        "type": "object",
        "description": "A team reference: id and name only.",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "UserDto": {
        "type": "object",
        "description": "A user as exposed by the API.",
        "required": [
          "id",
          "email",
          "displayName"
        ],
        "properties": {
          "avatarUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
